model Request {
  id         String  @id @default(cuid())
  assignedTo String?

  type   RequestType
  status RequestStatus @default(new)

  name    String
  phone   String
  message String?

  desire           Desire?
  propertyCategory ListingCategory?
  propertyType     ListingType?
  city             String?
  district         String?
  priceMin         Float?
  priceMax         Float?
  familyType       FamilyType?

  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt


  assignee User?    @relation("RequestAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([assignedTo])
  @@index([type])
  @@index([status])
  @@index([phone])
  @@index([createdAt])
  
}