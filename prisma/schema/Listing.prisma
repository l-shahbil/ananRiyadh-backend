model Listing {
    id      String @id @default(cuid())
    ownerId String
    slug    String @unique
    AdNumber   Int?

    titleAr       String
    titleEn       String
    descriptionAr String?
    descriptionEn String?

    category ListingCategory
    type     ListingType
    purpose  ListingPurpose

    price Float
    area  Float

    rooms       Int?
    livingRooms Int?
    bathRooms   Int?

    facing      Facing?
    streetWidth Float?

    facing2      Facing?
    streetWidth2 Float?

    facing3      Facing?
    streetWidth3 Float?

    floor       Int?
    totalFloors Int?

    status     ListingStatus @default(active)
    isFeatured Boolean       @default(false)

    cityId     String
    districtId String



    expiresAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    viewCount Int @default(0)

    owner  User           @relation("ListingOwner", fields: [ownerId], references: [id])
    images ListingImage[]
    district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
    city       City     @relation(fields: [cityId], references: [id], onDelete: Restrict)


    @@index([ownerId])
    @@index([slug])
    @@index([status])
    @@index([category])
    @@index([type])
    @@index([purpose])
    @@index([isFeatured])
    @@index([cityId, districtId])
    @@index([expiresAt])
    @@index([createdAt])
    @@index([status, cityId, category, purpose])
}
