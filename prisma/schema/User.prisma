model User{
    id              String      @id @default(cuid())
    name            String      
    nameEn   String?
    email           String      @unique
    passwordHash    String
    role            Role        @default(staff)
    status          UserStatus  @default(active)
    phone           String?      @unique
    whatsappNumber   String?
    telegramChatId  String?
    createAt        DateTime    @default(now())
    updateAt        DateTime    @updatedAt   

    //relationship
    listings        Listing[]    @relation("ListingOwner")
    requests        Request[]    @relation("RequestAssignee")
    internalOffer   InternalOffer[] @relation("OfferAuthor")

    @@index([email])
    @@index([status])
    @@index([role])
}